# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# TMDB "API Read Access Token" (v4, used as a Bearer token) from https://www.themoviedb.org/settings/api
TMDB_API_READ_TOKEN=

# Used in the User-Agent header for Open Library and Wikidata requests (both ask for contact info)
CONTACT_EMAIL=

MEDIAN_DB_PATH=data/median.db
# Hard stop on LLM spend per day, in USD
DAILY_USD_LIMIT=2
